# Allowlist: publish reviewed source/research; raw game data and analysis stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/port.py
!/port-lock.json
!/config/
/config/*
!/config/retail-functions.csv
!/config/retail.toml
!/patches/
/patches/*
!/patches/runtime.patch
!/tests/
/tests/*
!/tests/test_port.py
!/RUMBLE-RACING-SIMULATION-HANDOFF.md
!/analysis/
/analysis/*
!/analysis/README.md
!/analysis/PORTING-SUMMARY.md
!/analysis/ASSETS-AND-DEBUG.md
!/analysis/retail-exact-function-matches.csv
!/analysis/prototype-vs-retail-files.csv
!/analysis/debug-command-strings.csv
